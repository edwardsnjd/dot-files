#!/usr/bin/env bash

# NAME
#   llm-completions - A command-line tool to interact with LLMs for coding completions.
#
# SYNOPSIS
#   llm-completions < CODE
#
# USAGE
#   CODE - inline code with special marker `<@CURSOR@>`
#
# DEPENDENCIES
#   - llm: Command-line interface for interacting with LLMs.
#   - llm-run: Wrapper to run llm without model thinking.
#   - $COMPLETION_MODEL: Environment variable for model (default: qwen3.5-code)
#   - $MODEL: Environment variable for model (default: qwen3.5-code)

set -o nounset
set -o errexit
set -o pipefail
#set -o xtrace

DEFAULT_MODEL="qwen3.5-code"
SELECTED_MODEL="${COMPLETION_MODEL:-${MODEL:-$DEFAULT_MODEL}}"

Main() {
  BuildPrompt $SELECTED_MODEL \
    | llm-run --no-think -m "$SELECTED_MODEL" \
    | sed -E 's/<EOT>//' \
    | sed -E '/^```/d'
}

function BuildPrompt() {
  local model="${1:?Missing model}"

  case "$model" in
    "codellama:7b-code" \
      | "codellama:13b-code" \
      | "codellama-13b-code" \
      | "codellama-13b-code:latest" \
      ) BuildLlamaCodePrompt ;;
    "qwen3-coder:30b" \
      | "qwen3-coder" \
      | "qwen3-coder:latest" \
      | "qwen3-coder-code" \
      | "qwen3-coder-code:latest" \
      | "qwen3.5-code" \
      | "qwen3.5-code:latest" \
      ) BuildQwenCodePrompt ;;
    *) BuildDefaultPrompt ;;
  esac
}

function BuildLlamaCodePrompt() {
  sed -E '1s/^/<PRE>/; s/<@CURSOR@>/<SUF>/;'
  printf "<MID>"
}

function BuildQwenCodePrompt() {
  sed -E '1s/^/<|fim_prefix|>/; s/<@CURSOR@>/<|fim_suffix|>/;'
  printf "<|fim_middle|>"
}

function BuildDefaultPrompt() {
  cat <<-EOF
		Complete the given code snippet at the position of the marker <@CURSOR@>.
		
		STRICT RULES:
		- Only provide the code completion without any explanations or comments.
		- Do not include the marker <@CURSOR@> in the completion.
		- Do not include the prefix or suffix in your response, only the completion.
		- Only reply with code completion to the end of the line.
		
		EXAMPLES:
		For input 'const add = (a, b) => <@CURSOR@>; // Adds' the output should be 'a + b'.
		For input 'const mult = (a, b) => <@CURSOR@>;' the output should be 'a * b'.
		
		CODE TO COMPLETE:
		$(cat)
	EOF
}

Main "$@"
