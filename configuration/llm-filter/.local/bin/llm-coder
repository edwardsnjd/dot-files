#!/usr/bin/env bash

# NAME
#   llm-coder - A command-line tool to interact with LLMs for coding assistance.
#
# SYNOPSIS
#  llm-coder [PROMPT] < input_file
#
# EXAMPLE
#  llm-coder < input_file "Generate unit tests for the provided code."
#    Process the input as requested.
#
#  llm-coder < input_file
#    Interactively prompt for user instructions to process the input.
#
# DEPENDENCIES
#   - llm: Command-line interface for interacting with LLMs.
#   - llm-run: Wrapper to run llm without model thinking.
#
# ENVIRONMENT
#   - $MODEL: Environment variable for model (default: qwen3.5-coding).

set -o nounset
set -o errexit
set -o pipefail
#set -o xtrace

MODEL="${MODEL:-qwen3.5-coding}"

Main() {
  local userPrompt=$(GetUserPrompt "$@")

  if [ -z "$userPrompt" ]; then
    echo "Error: No prompt provided." >&2
    exit 1
  fi

  BuildPrompt "$userPrompt" "$(cat)" | llm-run --no-think --model "$MODEL"
}

function GetUserPrompt() {
  local userPrompt="${1:-}"

  if [ -z "$userPrompt" ]; then
    # NOTE: Use /dev/tty to read input because we expect
    # stdin to be redirected from a file or pipe.
    echo ""
    read -e -p "Prompt> " userPrompt < /dev/tty
  fi

  echo "$userPrompt"
}

function BuildPrompt() {
  cat <<-EOF
		You are a helpful programming assistant. Please follow the user's instructions carefully.
		
		Unless directly instructed otherwise, reply with raw unadorned code, not markdown.
		
		User Instructions:
		
		<instructions>
		$1
		</instructions>
		
		Input:
		
		<input>
		$2
		</input>
		
		Again, the user instructions:
		
		<instructions>
		$1
		</instructions>
	EOF
}

Main "$@"
