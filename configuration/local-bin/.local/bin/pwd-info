#!/usr/bin/env bash

# NAME
#   pwd-info - print info about pwd

DOCKER="${DOCKER:-docker}"

DIVIDER="┄"

DIM=$(tput bold; tput setaf 0)
BRIGHT="$(tput dim; tput setaf 5)"
HEADER="$(tput bold; tput setaf 6)"
RESET="$(tput sgr0)"

function heading() {
  centre --filler "$DIVIDER" \
    | sed -E "s/^([^ ]*) (.*) ([^ ]*)$/${DIM}\\1${RESET} ${BRIGHT}\\2${RESET} ${DIM}\\3${RESET}/"
}

echo "pwd" | heading
pwd

command -v $DOCKER >/dev/null 2>&1 && {
  echo "$DOCKER compose" | heading
  $DOCKER compose config --quiet 2> /dev/null \
    && $DOCKER compose ps --format 'table {{.Name}}\t{{.Image}}\t{{.Service}}\t{{.RunningFor}}\t{{.Status}}' \
    || echo "No compose file found."
}

command -v msb-list >/dev/null 2>&1 && {
  echo "msb" | heading
  msb-list
}

command -v sbx >/dev/null 2>&1 && {
  echo "sbx" | heading
  sandboxes=$(
    sbx ls --json \
      | jq --raw-output "
        .sandboxes[]
        | select(.workspaces[]? == \"$PWD\")
        | [.name, .agent, .created_at, .status]
        | @tsv
      "
  )
  if [ -n "$sandboxes" ]; then
    {
      echo "NAME	AGENT	CREATED AT	STATUS"
      echo "$sandboxes"
    } \
      | column -t -s $'\t' \
      | sed -E "1 s/([^\t]+)/${HEADER}\1${RESET}/g"
  else
    echo "No sandboxes found."
  fi
}

command -v git >/dev/null 2>&1 && {
  echo "git" | heading
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    && {
      git st
      mainBranch=$(
        if git show-ref --verify --quiet refs/heads/master; then
          echo "master"
        else
          echo "main"
        fi
      )
      git lg ${mainBranch}..
    } \
    || echo "Not a git repo."
}

echo "§" | heading
echo
