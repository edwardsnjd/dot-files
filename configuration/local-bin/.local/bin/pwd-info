#!/usr/bin/env bash

# NAME
#   pwd-info - print info about pwd

DOCKER="${DOCKER:-docker}"

function heading() {
  centre --filler "┄"
}

echo "pwd" | heading
pwd

echo "git" | heading
git st

echo "$DOCKER" | heading
$DOCKER compose config --quiet 2> /dev/null \
  && $DOCKER compose ps \
  || echo "No compose file found."

echo "msb" | heading
msb-list

echo "ls" | heading
gls --color=auto -AFl --group-directories-first

echo "▽" | heading
