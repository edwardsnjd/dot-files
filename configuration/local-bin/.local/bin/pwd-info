#!/usr/bin/env bash

# NAME
#   pwd-info - print info about pwd

DOCKER="${DOCKER:-docker}"

DIVIDER="┄"

DIM=$(tput bold; tput setaf 0)
BRIGHT="$(tput dim; tput setaf 5)"
RESET="$(tput sgr0)"

function heading() {
  centre --filler "$DIVIDER" \
    | sed -E "s/^(.*) (.*) (.*)$/${DIM}\\1${RESET} ${BRIGHT}\\2${RESET} ${DIM}\\3${RESET}/"
}

echo "pwd" | heading
pwd

command -v $DOCKER >/dev/null 2>&1 && {
  echo "$DOCKER" | heading
  $DOCKER compose config --quiet 2> /dev/null \
    && $DOCKER compose ps \
    || echo "No compose file found."
}

command -v msb-list >/dev/null 2>&1 && {
  echo "msb" | heading
  msb-list
}

echo "git" | heading
git st

echo "§" | heading
echo
