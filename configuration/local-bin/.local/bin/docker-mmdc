#! /usr/bin/env bash

# NAME
#   docker-mmdc - dockerised mermaid cli (mmdc)

set -o nounset
set -o errexit
set -o pipefail
#set -o xtrace

DOCKER="${DOCKER:-docker}"

function DockerMmdc() {
  $DOCKER run \
    --rm \
    -ti \
    -v "$PWD":/data \
    minlag/mermaid-cli \
    "$@"
}

DockerMmdc "$@"
