#!/usr/bin/env bash

# NAME
#   words - Pick or list words from a dictionary
#
# SYNOPSIS
#   words [--interactive | --list] [<query>]
#
# OPTIONS
#   -i, --interactive    Interactive fzf picker (default)
#   -l, --list           Print the words plainly
#   query                Initial fzf query (interactive mode only)
#
# ENVIRONMENT VARIABLES
#   DICTIONARY_FILE      Word list path (default: /usr/share/dict/words)
#
# EXAMPLE
#   words --list
#   DICTIONARY_FILE=mydict.txt words --interactive method
#
# DEPENDENCIES
#   fzf - for interactive mode

set -o nounset
set -o errexit
set -o pipefail

DICTIONARY_FILE="${DICTIONARY_FILE:-/usr/share/dict/words}"

function Main() {
  local cmd="interactive"

  local query=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -i|--interactive) cmd="interactive" && shift ;;
      -l|--list) cmd="list" && shift ;;
      -*) echo "Unknown option $1" >&2 && exit 1 ;;
      *) query="$1" && shift ;;
    esac
  done

  case "$cmd" in
    list) cat "$DICTIONARY_FILE" ;;
    interactive) fzf --query "$query" < "$DICTIONARY_FILE" ;;
  esac
}

Main "$@"
