#!/usr/bin/env bash

# NAME
#   safeagent - prepare sandboxed environment for agent
#
# SYNOPSIS
#   safeagent [--profile PROFILE] [FENCE_ARGS...]
#
# PROFILES
#   The name of the profile is used to locate the JSONC file in the
#   $HOME/.config/fence directory as fence-<profile>.jsonc.
#   If no profile is specified, the default profile is used.

export GIT_AUTHOR_NAME="agent"
export GIT_AUTHOR_EMAIL="agent@local"

profile=()
while :; do
  case "${1:-}" in
    -p|--profile) profile=(--settings "$HOME/.config/fence/fence-$2.jsonc"); shift 2 ;;
    *) break ;;
  esac
done

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  fence \
    "${profile[@]}" \
    --expose-host-path-rw "$(git rev-parse --git-dir)" \
    "$@"
else
  fence \
    "${profile[@]}" \
    "$@"
fi
