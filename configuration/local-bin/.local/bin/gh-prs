#!/usr/bin/env bash

# NAME
#   gh-prs - list Github PRs
#
# USAGE
#   gh-prs REPO [AUTHOR]
#
# EXAMPLE
#   gh-prs owner/repo foobar
#
# OUTPUT
#   TSV with the columns:
#     repo
#     number
#     author
#     title
#     body
#     createdAt
#     mergedAt
#     closedAt
#     firstReviewedAt
#     firstApprovedAt
#     state
#     comments
#     reviews
#     commits
#     changedFiles
#     additions
#     deletions

set -o nounset
set -o errexit
set -o pipefail
#set -o xtrace

function Main() {
  local repo="${1:?Requires repo e.g. owner/repo}"
  local author="${2:-}"

  local owner="${repo%%/*}"
  local name="${repo#*/}"

  echo "repo	number	author	title	body	createdAt	mergedAt	closedAt	firstReviewedAt	firstApprovedAt	state	comments	reviews	commits	changedFiles	additions	deletions"

  GH_PRS_AUTHOR="$author" gh api graphql \
    --paginate \
    --raw-field query="$(QueryGQL)" \
    --raw-field owner="$owner" \
    --raw-field name="$name" \
    --jq '
      .data.repository.pullRequests.nodes[]
      | select(env.GH_PRS_AUTHOR == "" or .author.login == env.GH_PRS_AUTHOR)
      | [
        .repository.nameWithOwner,
        .number,
        .author.login,
        .title,
        (.body | length),
        .createdAt, .mergedAt, .closedAt,
        .firstReviewedAt.nodes[0].submittedAt,
        .firstApprovedAt.nodes[0].submittedAt,
        .state,
        .comments.totalCount,
        .reviews.totalCount,
        .commits.totalCount,
        .changedFiles, .additions, .deletions
      ] | @tsv
    '
}

function QueryGQL() {
  cat <<- "GQL"
	query($owner: String!, $name: String!, $endCursor: String) {
	  repository(owner: $owner, name: $name) {
	    pullRequests(
	      after: $endCursor
	      first: 25
	      orderBy: { field: CREATED_AT, direction: ASC }
	    ) {
	      pageInfo {
	        hasNextPage
	        endCursor
	      }
	      nodes {
	        repository { nameWithOwner }
	        number
	        author { login }
	        title
	        body
	        createdAt
	        mergedAt
	        closedAt
	        state
	        comments { totalCount }
	        reviews { totalCount }
	        commits { totalCount }
	        changedFiles
	        additions
	        deletions
	        firstReviewedAt: reviews(first: 1) {
	          nodes { submittedAt }
	        }
	        firstApprovedAt: reviews(first: 1, states: [APPROVED]) {
	          nodes { submittedAt }
	        }
	      }
	    }
	  }
	}
	GQL
}

Main "$@"
