#!/usr/bin/env bash

# NAME
#   list-keys - fzf browse of all configured key bindings in your shell
#
# USAGE
#   source list-keys [--list]

function Main() {
  local interactive=1

  local otherArgs=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      -l|--list) interactive=0 && shift ;;
      *) otherArgs+=("$1") && shift ;;
    esac
  done
  set -- "${otherArgs[@]}" # restore positional parameters

  ListKeys | {
    if [ "$interactive" -eq 1 ]; then
      fzf \
        --reverse \
        --no-sort \
        --ellipsis "⋯" \
        --header-lines=1
    else
      cat
    fi
  }
}

function ListKeys() {
  # HACK: Columnize header with data to match expected columns
  {
    echo "app	mode	key(s)	command(s)"
    [[ -x "$(command -v list-readline-keys)" ]] && source list-readline-keys
    [[ -x "$(command -v list-fzf-keys)" ]] && list-fzf-keys
    [[ -x "$(command -v list-tmux-keys)" ]] && list-tmux-keys
    [[ -x "$(command -v list-w3m-keys)" ]] && list-w3m-keys
  } \
    | column -s $'\t' -t \
    | body sort
}

Main "$@"
