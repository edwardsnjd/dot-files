{
  "$schema": "https://raw.githubusercontent.com/Use-Tusk/fence/main/docs/schema/fence.schema.json",
  "extends": "./fence.jsonc",
  "filesystem": {
    "allowRead": [
      // Playwright
      "~/Library/Caches/ms-playwright/",
    ],
    "allowWrite": [
      // Playwright
      "~/Library/Caches/ms-playwright/",
    ],
  },
  "macos": {
    "mach": {
      "register": [
        "org.chromium.Chromium.MachPortRendezvousServer.*",
      ],
      "lookup": [
        "org.chromium.Chromium.MachPortRendezvousServer.*",
      ]
    }
  }
}
