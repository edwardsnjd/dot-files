#! /usr/bin/env bash

check_model() {
  local model="$1"

  echo "$model"
  ollama run --think=false "$model" "say hi" > /dev/null
  ollama ps
  ollama stop "$model"
}

models=(
  "gemma4:12b-mlx"
  "ornith:latest"
  "ornith:9b"
  "qwen3.5:9b-mlx"
  "gemma4:e4b-mlx"
  "gemma4:latest"
  "gemma4:12b"
  "nemotron-3-nano:4b"
  "gemma4-e4b-code:latest"
  "gemma4-e4b-coding:latest"
  "gemma4:e4b"
  "qwen3.5-code:latest"
  "qwen3.5-reasoning:latest"
  "qwen3.5-coding:latest"
  "qwen3.5-action:latest"
  "qwen3.5:9b"
  "ministral-3:8b"
  "ministral-3:latest"
  "ministral-3:3b"
  "qwen3:8b"
  "codellama:7b"
  "codellama:7b-code"
  "codellama:13b"
  "ministral-3-3b-ctx:latest"
  "ministral-3-ctx:latest"
)

for model in "${models[@]}"; do
  check_model "$model"
done
