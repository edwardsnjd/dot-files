#! /usr/bin/env bash

# Run a sandbox in this PWD

# Look for local image by default
SANDBOX_IMAGE="${SANDBOX_IMAGE:-localhost/msb-agent:latest}"

# Use directory name as default project
PROJECT="${PROJECT:-$(basename $(pwd))}"
SANDBOX_NAME="${PROJECT}-${RANDOM}"

# Support symlinked agents config
AGENTS_DIR="$(realpath $HOME/.agents)"

function startSandbox() {
  msb run \
    --name "${SANDBOX_NAME}" \
    --secret "PERPLEXITY_API_KEY@api.perplexity.ai" \
    --secret "OPENROUTER_API_KEY@openrouter.ai" \
    --secret "INCEPTION_API_KEY@api.inceptionlabs.ai" \
    --mount-dir "${AGENTS_DIR}:/root/.agents:ro" \
    --mount-dir "$PWD:$PWD" \
    --workdir "$PWD" \
    --label "msb.pwd=$PWD" \
    --net "public,host" \
    "$@" \
    "$SANDBOX_IMAGE"
}

function cleanupSandbox() {
  msb stop "$SANDBOX_NAME" && msb remove "$SANDBOX_NAME"
}

trap cleanupSandbox EXIT

startSandbox "$@"
